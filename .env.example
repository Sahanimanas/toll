# Reference for this project's environment files. Copy the relevant blocks into
# backend\.env and frontend\.env, and change every secret before deploying.

# ---------------- backend\.env ----------------
# SQLite by default; point at Postgres for production.
ANPR_DATABASE_URL=sqlite:///./dev.db

# JWT signing secret — 32+ bytes. Generate: openssl rand -hex 32
ANPR_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Shared key the pipeline uses to POST recognitions (X-API-Key header).
# MUST match the pipeline's ANPR_INGEST_API_KEY.
ANPR_INGEST_API_KEY=change-me-generate-with-openssl-rand-hex-32
ANPR_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Bootstrap admin for the /api/v1 ANPR API. Separate from the operator console
# login, which is seeded as admin / 12345678 by backend/app/toll/seed.py.
ANPR_FIRST_ADMIN_EMAIL=admin@example.com
ANPR_FIRST_ADMIN_PASSWORD=change-me-admin-password

# Origins allowed to call the API (the Vite dev server).
ANPR_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional overrides: where /videos is served from, and where plate crops are
# written (served at /storage). Defaults: <project>/videos and backend/storage.
# ANPR_TOLL_VIDEOS_DIR=
# ANPR_TOLL_STORAGE_DIR=./storage

# ---------------- frontend\.env ----------------
# VITE_BACKEND_URL=http://localhost:8000

# ---------------- pipeline (env vars, optional) ----------------
ANPR_PIPELINE_REGION=IN
ANPR_PIPELINE_MIN_OCR_CONFIDENCE=0.60
ANPR_PIPELINE_DEDUP_TTL_SECONDS=30
# AI compute device: auto / cpu / cuda / cuda:N
ANPR_PIPELINE_DEVICE=auto
